# AWS configuration. Keep credentials in the AWS profile, never in this file.
AWS_PROFILE=aidev
AWS_REGION=us-east-1

# Use offline mode for the default smoke test.
RAMEA_MODE=offline
RAMEA_TEXT_MODEL_ID=openai.gpt-oss-120b-1:0
RAMEA_VISION_MODEL_ID=amazon.nova-lite-v1:0
RAMEA_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
